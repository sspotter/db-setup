# Port this dashboard listens on (systemd may also set it; the environment wins over this file)
PORT=8444
# Interface to bind; blank = all interfaces (localhost is always served)
HOST=
# Password the page sends as x-dashboard-password
DASHBOARD_PASSWORD=
# TikTok backend base URL (127.0.0.1, not localhost: TikTok binds IPv4 loopback only, never ::1)
TIK_URL=http://127.0.0.1:8443
# TikTok backend admin password (sent as x-admin-password; never reaches the browser)
TIK_ADMIN_PASSWORD=
# Instagram backend base URL
INSTA_URL=http://127.0.0.1:8442
# Instagram backend admin password (sent as x-admin-password; never reaches the browser)
INSTA_ADMIN_PASSWORD=
# Optional: where the BROWSER opens each backend's admin page (the "TikTok admin" / "Instagram admin" buttons).
# Leave blank to use this page's own host with ports 8443 / 8442. /admin.html is added when missing.
TIK_ADMIN_URL=
INSTA_ADMIN_URL=
