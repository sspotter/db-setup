{
  "manifest_version": 3,
  "name": "Insta Surfer — Multi-Function",
  "version": "3.0.0",
  "description": "Capture posts and comments datasets from Instagram while browsing. Extract posts and comments datasets automatically.",
  "update_url": "https://instasurfer-update-server.vercel.app/updates.xml",

  "permissions": [
    "storage",
    "activeTab",
    "cookies",
    "webRequest",
    "scripting",
    "alarms"
  ],

  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.vercel.app/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Insta Surfer"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://*.instagram.com/*"]
    }
  ]
}
