# Insta Surfer Backend — environment template.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database --------------------------------------------------------------
# If LOCAL_DATABASE_URL is set, it is used. URL-encode special chars (e.g. & -> %%26).
LOCAL_DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# Production/fallback database (used when LOCAL_DATABASE_URL is unset)
# DATABASE_URL=postgresql://user:password@host:5432/your_database

# --- Server ----------------------------------------------------------------
PORT=8442

# --- Auth ------------------------------------------------------------------
# Set a strong value. If unset the code falls back to a public default secret.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin panel password — use a strong, unique value.
ADMIN_PASSWORD=

# --- Admin activity log / diagnostics --------------------------------------
# Public base URL(s) for admin-generated password reset links, comma-separated
# (one link per URL is shown in the admin panel). No trailing path.
# REQUIRED for the "Reset link" button; it errors while this is empty.
RESET_BASE_URLS=https://medpush-virtual-machine.tail3e5104.ts.net

# A successful request slower than this (ms) is also written to the activity log.
SLOW_REQUEST_MS=2000
# Which successful requests are recorded: all (default) | writes (POST/PUT/DELETE only) | none.
# Failures, logins and slow requests are always recorded. Rows are pruned after 90 days.
ACTIVITY_LOG_SUCCESS=all
# Alert banner thresholds over a 15-minute window.
ALERT_FAILED_LOGINS_PER_IP=10
ALERT_5XX_PER_15MIN=5
